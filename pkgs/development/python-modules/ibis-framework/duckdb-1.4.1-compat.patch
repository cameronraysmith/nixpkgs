From f9f23635fb2eea6bc7bc8e2b3b667033c1b20aed Mon Sep 17 00:00:00 2001
From: Alessandro Molina <alessandro.molina@posit.co>
Date: Tue, 7 Oct 2025 16:18:40 +0200
Subject: [PATCH] fix(duckdb): support duckdb 1.4.1

duckdb 1.4.1 deprecated duckdb.functional in favor of duckdb.func.
This patch adds a fallback to support both old and new duckdb versions.

Backported from upstream commit f9f23635fb2eea6bc7bc8e2b3b667033c1b20aed
---
 ibis/backends/duckdb/__init__.py | 10 ++++++++--
 1 file changed, 8 insertions(+), 2 deletions(-)

diff --git a/ibis/backends/duckdb/__init__.py b/ibis/backends/duckdb/__init__.py
index 91aa8ced2..d1c6e8cb0 100644
--- a/ibis/backends/duckdb/__init__.py
+++ b/ibis/backends/duckdb/__init__.py
@@ -49,9 +49,15 @@ if TYPE_CHECKING:
     from ibis.expr.schema import SchemaLike


+try:
+    from duckdb import func as _duckdb_func
+except ImportError:
+    from duckdb import functional as _duckdb_func
+
+
 _UDF_INPUT_TYPE_MAPPING = {
-    InputType.PYARROW: duckdb.functional.ARROW,
-    InputType.PYTHON: duckdb.functional.NATIVE,
+    InputType.PYARROW: _duckdb_func.ARROW,
+    InputType.PYTHON: _duckdb_func.NATIVE,
 }


--
2.47.0
